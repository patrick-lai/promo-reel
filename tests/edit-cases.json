{
 "_": "Shared cases for the editor's edits: pytest runs them through promo/editor.py apply_ops, node --test through PF.editApply (mods/promo-flow/logic.js), so the Stage's instant preview and the render cannot drift. `expect` is a subset of the result; `error` a part of the message.",
 "B": 0.5,
 "spec": {
  "timeline": {
   "bpm": 120,
   "beats": 32
  },
  "output": {
   "name": "t",
   "duration": 16.0
  },
  "music": {
   "asset": "music-a",
   "bpm": 120,
   "track_beat": 0.5,
   "track_offset": 0.0,
   "edit": {
    "segments": [
     [
      0,
      0,
      32
     ]
    ],
    "crossfade": 0.03,
    "gains": [
     {
      "beats": [
       24,
       32
      ],
      "db": -3
     }
    ],
    "silence_from_beat": 31
   }
  },
  "vo": {
   "engine": "files",
   "asset": "vo-files",
   "lines": [
    {
     "id": "a1",
     "shot": "01",
     "at": 0.5,
     "file": "a1.wav",
     "text": "One.",
     "sha256": "x"
    },
    {
     "id": "a2",
     "shot": "02",
     "at": 2.5,
     "file": "a2.wav",
     "text": "Two."
    },
    {
     "id": "a3",
     "shot": "03",
     "at": 0.2,
     "file": "a3.wav",
     "text": "Three."
    }
   ]
  },
  "sfx": {
   "library": {
    "hit": {
     "asset": "sfx-hit"
    }
   }
  },
  "mix": {
   "bus_db": {
    "music": -5,
    "sfx": -8,
    "vo": 1.5
   }
  },
  "shots": [
   {
    "id": "01",
    "beats": [
     0,
     8
    ],
    "type": "clip",
    "source": "rec-a",
    "t_in": 1.0,
    "overlays": [
     {
      "type": "caption",
      "text": "Tell it.",
      "t": [
       0,
       3
      ]
     }
    ]
   },
   {
    "id": "02",
    "beats": [
     8,
     16
    ],
    "type": "clip",
    "source": "rec-b",
    "t_in": 0,
    "speed": 2,
    "overlays": [
     {
      "type": "caption",
      "text": "It plans.",
      "t": [
       0.5,
       2.5
      ]
     },
     {
      "type": "text",
      "text": "late",
      "t": [
       2.5,
       4
      ]
     }
    ],
    "sfx": [
     {
      "sfx": "hit",
      "at": 0.5,
      "db": -5
     },
     {
      "sfx": "hit",
      "at": 3.0
     }
    ]
   },
   {
    "id": "03",
    "beats": [
     16,
     24
    ],
    "type": "card",
    "source": "rec-c",
    "ui": false
   },
   {
    "id": "04",
    "beats": [
     24,
     32
    ],
    "type": "dawn",
    "name": "Acme"
